# ---- data & caches (not redistributable / too large) ----
data/*
!data/*.py
*.npy
*.npz.tmp

# ---- training runs & checkpoints ----
results/
results_*/
*.pth
*.pt
*.ckpt

# ---- quantized / compiled artifacts ----
*.onnx
*.hbm
*.hb
*.om
*.bin
# compiled bytecode models embed dataset-derived weights
*.bc
# compiler dumps; the same numbers are in *_node_info.csv / *_advice.csv
npu_quant/out/**/*.html
quant_runs/H[123]/
quant_runs/ema_*/
quant_runs/backend_ov_onnx/
npu_quant/calib/
npu_quant/onnx/
npu_quant/testbin/
.hb_model_info/

# ---- transient output ----
logs/
output/
__pycache__/
*.pyc
hb_compile.log
.fitz/

# ---- internal working notes (kept out of the artifact) ----
CLAUDE.md
PAPER_BACKLOG.md
experiments.md
drafts/_*
drafts/.*
drafts/preview/
drafts/~$*
drafts/mso*.tmp
dist/

drafts/submission/
drafts/_r37/

# vendor / compiler build artifacts (rebuilt on demand)
npu_quant/out/*/
# per-image error cache, regenerated by scripts/leak_contrast.py
quant_runs/leakpred/
quant_runs/mechanism_cache/
# python packaging artefacts (pip install . makes these)
build/
*.egg-info/
# delivered polishing package (local only, figures duplicate drafts/figs)
drafts/polished/
# generated Chinese deliverables (rebuild with scripts/_publish_journal.py)
drafts/paper2_snap_order_zh.docx
drafts/paper2_snap_order_zh.pdf
# assembled submission package (figures duplicate drafts/figs)
drafts/final_submission/
drafts/final_submission.zip
# landscape graphical abstract ships in the submission package, not the artifact
# (the generator, scripts/paper2_graphical_abstract.py, is tracked and regenerates it)
drafts/figs/figGA_landscape.png
# Chinese reading versions of the supplement and stray reference PDFs
drafts/esm_zh.*
/Neurocomputing_*.pdf
